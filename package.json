{
  "name": "liftbay",
  "version": "0.8.0",
  "description": "Build, sign, submit and update React Native apps from your own CI.",
  "keywords": [
    "react-native",
    "expo",
    "ci",
    "ota",
    "codepush",
    "expo-updates",
    "testflight",
    "google-play",
    "cli"
  ],
  "homepage": "https://liftbay.dev/docs",
  "bugs": {
    "url": "https://github.com/liftbay/cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liftbay/cli.git"
  },
  "license": "Apache-2.0",
  "author": "Liftbay",
  "type": "module",
  "bin": {
    "liftbay": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@clack/core": "1.5.1",
    "@clack/prompts": "^1.8.1",
    "@liftbay/sdk": "^0.1.3",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/node-forge": "^1.3.14",
    "commander": "^15.0.0",
    "node-forge": "^1.4.0",
    "picocolors": "^1.1.1",
    "qrcode": "^1.5.4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {}
}
